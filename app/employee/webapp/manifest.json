{
  "_version": "1.59.0",
  "sap.app": {
    "id": "psasprint.employee",
    "type": "application",
    "title": "PSA Sprint - Employee Dashboard",
    "description": "Project and Services Administration - Employee Self-Service",
    "dataSources": {
      "mainService": {
        "uri": "/psa/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "psasprint.employee.view.App",
      "type": "XML",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.tnt": {},
        "sap.ui.layout": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "/common/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "psasprint.employee.view",
        "controlId": "pageContainer",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "dashboard",
          "target": "dashboard"
        }
      ],
      "targets": {
        "dashboard": {
          "viewName": "Dashboard",
          "viewId": "dashboardView",
          "viewLevel": 1
        }
      }
    }
  }
}
